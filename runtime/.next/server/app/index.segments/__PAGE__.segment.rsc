nded-full px-3.5 py-1.5 text-[13px] font-medium transition-colors bg-surface text-fg-2 hover:bg-surface-2 hover:text-fg","children":"Fantasy"}]}],["$","li","Game",{"className":"shrink-0","children":["$","$L19",null,{"href":"/search?tag=Game","className":"block rounded-full px-3.5 py-1.5 text-[13px] font-medium transition-colors bg-surface text-fg-2 hover:bg-surface-2 hover:text-fg","children":"Game"}]}],["$","li","Gia đình",{"className":"shrink-0","children":["$","$L19",null,{"href":"/search?tag=Gia+%C4%91%C3%ACnh","className":"block rounded-full px-3.5 py-1.5 text-[13px] font-medium transition-colors bg-surface text-fg-2 hover:bg-surface-2 hover:text-fg","children":"Gia đình"}]}],["$","li","Gothic",{"className":"shrink-0","children":["$","$L19",null,{"href":"/search?tag=Gothic","className":"block rounded-full px-3.5 py-1.5 text-[13px] font-medium transition-colors bg-surface text-fg-2 hover:bg-surface-2 hover:text-fg","children":"Gothic"}]}],["$","li","Hài hước",{"className":"shrink-0","children":["$","$L19",null,{"href":"/search?tag=H%C3%A0i+h%C6%B0%E1%BB%9Bc","className":"block rounded-full px-3.5 py-1.5 text-[13px] font-medium transition-colors bg-surface text-fg-2 hover:bg-surface-2 hover:text-fg","children":"Hài hước"}]}],["$","li","Hải tặc",{"className":"shrink-0","children":["$","$L19",null,{"href":"/search?tag=H%E1%BA%A3i+t%E1%BA%B7c","className":"block rounded-full px-3.5 py-1.5 text-[13px] font-medium transition-colors bg-surface text-fg-2 hover:bg-surface-2 hover:text-fg","children":"Hải tặc"}]}],["$","li","Hành động",{"className":"shrink-0","children":["$","$L19",null,{"href":"/search?tag=H%C3%A0nh+%C4%91%E1%BB%99ng","className":"block rounded-full px-3.5 py-1.5 text-[13px] font-medium transition-colors bg-surface text-fg-2 hover:bg-surface-2 hover:text-fg","children":"Hành động"}]}],["$","li","Hoàng gia",{"className":"shrink-0","children":["$","$L19",null,{"href":"/search?tag=Ho%C3%A0ng+gia","className":"block rounded-full px-3.5 py-1.5 text-[13px] font-medium transition-colors bg-surface text-fg-2 hover:bg-surface-2 hover:text-fg","children":"Hoàng gia"}]}],"$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25"]]}]}]]}]

APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./.data/lumi.db
AUTO_MIGRATE=true
DATA_DIR=.data
PUBLIC_APP_URL=http://localhost:3000
REDIS_URL=
# Explicit local text demo only. STT/TTS and payments are never simulated by this flag.
DEMO_LLM=false
GROQ_API_KEY=
GROQ_LLM_MODEL=qwen/qwen3.8-27b
GROQ_STT_MODEL=whisper-large-v3-turbo
# STT/LLM choices are managed in Admin -> AI providers and persisted in the database.
DEEPGRAM_API_KEY=
# API keys stay on the backend. Admin profiles refer to these names (never paste real keys here).
LLM_API_KEYS_JSON={}
LLM_ALLOWED_HOSTS=api.openai.com,openrouter.ai,api.groq.com
# Optional alternative: one Secrets Manager JSON value; direct variables above take precedence.
# AI_PROVIDER_CONFIG_JSON={"deepgram_api_key":"","llm_api_keys":{},"llm_allowed_hosts":["api.openai.com","openrouter.ai","api.groq.com"]}
GOOGLE_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_AUTH_MODE=api_key
GOOGLE_CLOUD_PROJECT=
# test -> API v2 sandbox; live -> API v2 production. Webhook secret must match this environment.
SEPAY_ENV=test
SEPAY_WEBHOOK_SECRET=
SEPAY_API_TOKEN=
SEPAY_BANK_CODE=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_HOLDER=
SEPAY_PAYMENT_PREFIX=LUMI
# Required in production. Generate: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
MFA_ENCRYPTION_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=lumi@example.com

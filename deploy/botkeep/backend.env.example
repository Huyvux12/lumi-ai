APP_ENV=botkeep-demo
AUTO_MIGRATE=false
PUBLIC_APP_URL=https://YOUR-FRONTEND-DOMAIN
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
MFA_ENCRYPTION_KEY=
DEMO_OWNER_EMAIL=demo-owner@example.com
DEMO_OWNER_PASSWORD=
DATA_DIR=.data
AUDIO_CACHE_TTL_SECONDS=3600
REDIS_URL=
SEPAY_ENV=test
# Optional provider secrets. Missing keys never simulate STT or TTS.
GROQ_API_KEY=
GOOGLE_API_KEY=
# SERVER_PORT is assigned by Botkeep Network; do not choose an arbitrary port.
